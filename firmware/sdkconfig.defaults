CONFIG_IDF_TARGET="esp32s3"

# XIAO ESP32-S3 Plus has 16 MB flash. Earlier config said 8 MB which
# matched only the lower half — esp-idf would log a warning and clamp
# binary header at 8 MB, leaving 8 MB unusable.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Safety nets — pin the interrupt + task watchdogs and the FreeRTOS
# stack-overflow canary on. These are ESP-IDF defaults, fixed here so a
# regenerated sdkconfig cannot silently drop them. A hung task or a
# blown stack then panics and reboots; the supervisor (drivers/
# supervisor/) charges that reset to its bounded fault budget, so even
# these faults cannot loop forever.
CONFIG_ESP_INT_WDT=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# BLE / NimBLE — services/ble/
# CONFIG_BT_ENABLED pulls in the BT controller; CONFIG_BT_NIMBLE_ENABLED
# selects NimBLE host (vs Bluedroid). NimBLE is leaner and the API
# our services/ble/ wraps. ESP32-S3 has BLE-only silicon so no
# BTDM controller-mode flags are needed.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n

# Default single-app partition table is 1 MB; the NimBLE stack
# alone adds ~250 KB so the app would overflow. Switch to the
# IDF-provided "large" single-app layout (~1.5 MB app).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_SINGLE_APP=n

# Battery Service (NimBLE built-in, UUID 0x180F + Battery Level 0x2A19).
# The service-level enable plus notify permission so the mobile app
# can subscribe and get push updates on battery percent.
CONFIG_BT_NIMBLE_BAS_SERVICE=y
CONFIG_BT_NIMBLE_SVC_BAS_BATTERY_LEVEL_NOTIFY=y

# NimBLE host log level — drop to WARNING. Default INFO prints
# "GATT procedure initiated: notify; att_handle=20" on every notify,
# which at our 50 Hz IMU notify cadence floods the UART with ~100
# log lines per second and drowns out the application logs we
# actually care about. WARNING still surfaces controller asserts,
# MTU errors, and disconnect reasons — anything that signals real
# trouble — without the per-packet noise.
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# NimBLE mbuf pool — the small (256 B) MSYS_1 blocks back every GATT
# notification (25 B IMU @ 50 Hz, 26 B metrics @ 50 Hz, 9 B shot, and the
# 28 B preshot bulk-transfer frames). The IDF default of 12 is exhausted when
# a preshot transfer (services/ble/, preshot_run_transfer) streams its ~1200
# frames back-to-back: those in-flight mbufs hold the whole pool, so the live
# IMU/metrics ble_hs_mbuf_from_flat() returns NULL and the 50 Hz stream
# collapses to 0. 32 leaves headroom for the live stream to always get a block
# while a bulk transfer is in flight. Cost ~5 KB internal RAM.
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32

# BLE TX power: max without external PA on ESP32-S3 is +9 dBm.
# Default ESP-IDF setting is +3 dBm; we bump to the chip ceiling so
# the link has the most margin we can give it from the firmware
# side. Note: the dominant gain factor for this board is the
# external FPC antenna on the U.FL connector — without it seated,
# the board loses ~20-30 dB regardless of TX power. See hardware
# notes (project_stabilitytracker_v1_device.md) for the antenna
# install procedure. Battery impact at 50 Hz BLE notify cadence is
# negligible (~5% over the +3 dBm baseline).
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P9=y

# PSRAM — the XIAO ESP32-S3 carries 8 MB of in-package octal SPI PSRAM
# (ESP32-S3R8; 8 MB exists only as octal — the quad part tops out at
# 2 MB). Enabled so heap_caps_malloc(MALLOC_CAP_SPIRAM) works: the
# pre-shot ring buffer (services/preshot/) is allocated there. The
# SPIRAM_USE choice defaults to MALLOC, which folds PSRAM into the heap
# — exactly what preshot needs, so it is left at the default.
# IGNORE_NOTFOUND keeps a PSRAM bring-up failure from looping the boot:
# preshot then simply logs DISABLED and the rest of the firmware runs.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
